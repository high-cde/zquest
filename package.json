{
  "name": "zquest",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "ZQuest: omaggi gratuiti, giochi di abilità e comunità per ZDOS e Red Velvet.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sprites": "node scripts/make-sprites.mjs",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run sprites && npm run build:web && npm run build:server",
    "start": "node dist/server.js",
    "dev": "npm run sprites && npm run build:web && tsx src/server.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "better-sqlite3": "^13.0.3",
    "bs58": "^6.0.0",
    "fastify": "^5.12.8",
    "grammy": "^1.46.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
