[Unit]
Description=ZQuest — omaggi, giochi e comunità
After=network.target

[Service]
Type=simple
User=zquest
Group=zquest
WorkingDirectory=/opt/zquest
Environment=NODE_ENV=production
EnvironmentFile=/opt/zquest/.env
ExecStart=/usr/bin/node /opt/zquest/dist/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zquest/data

[Install]
WantedBy=multi-user.target
