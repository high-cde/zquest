# ZQuest — copia questo file in .env e compilalo a mano.
# Non mettere mai chiavi private nel repository o nel frontend.

NODE_ENV=production
HOST=127.0.0.1
PORT=3200
DATABASE_PATH=./data/zquest.sqlite

# Obbligatori in produzione. Lo script di installazione può generarli.
SESSION_SECRET=change-me
ADMIN_TOKEN=change-me

# Login dimostrativo senza Telegram. In produzione lascialo false.
ALLOW_DEMO=false
# Inserisce qualche punteggio fittizio se il database è vuoto.
SEED_DEMO=false

# off | webhook | polling
# off: non chiamare getUpdates. Usalo se @RedVelvetOfficial_bot è già in ascolto
# (per esempio da VelvetHub) e monta il composer documentato nel README.
BOT_MODE=off
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://quest.x-zdos.it

# Domini accettati nel messaggio Sign-In-With-Solana, separati da virgola.
SIWS_DOMAIN=quest.x-zdos.it
SIWS_URI=https://quest.x-zdos.it

PRIVACY_CONTACT=@RedVelvetOfficial_bot
TERMS_VERSION=2026-11-07

# $OV — VELVET, Solana Token-2022. Decimali attesi: 6 (riletti dal mint all'avvio).
OV_MINT=2EN6Y1zM4yyt41gE2muzdJSAgRCAZiXqnmkgpbrspump
OV_DECIMALS=6
OV_REWARDS_PUBKEY=
# Chiave del portafoglio premi. Base58 (64 byte) oppure array JSON. Mai nel git.
OV_REWARDS_SECRET_KEY=
# Importi in gettoni interi, non in unità atomiche.
OV_DAILY_USER_CAP=500
OV_DAILY_GLOBAL_CAP=10000
OV_REWARDS_BUDGET=100000
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# $DSN — NETkali, ERC-20 su Polygon. Decimali attesi: 18 (riletti dal contratto all'avvio).
DSN_CONTRACT=0xfc90516a1f736FaC557e09D8853dB80dA192c296
DSN_DECIMALS=18
DSN_REWARDS_ADDRESS=
# Chiave esadecimale 32 byte, con o senza 0x. Mai nel git.
DSN_REWARDS_PRIVATE_KEY=
DSN_DAILY_USER_CAP=40
DSN_DAILY_GLOBAL_CAP=400
DSN_REWARDS_BUDGET=2000
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# I trasferimenti partono solo se questo vale true E le chiavi e il budget sono impostati.
# L'approvazione admin resta obbligatoria in ogni caso.
REWARDS_LIVE=false
